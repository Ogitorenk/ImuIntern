    - target: {fileID: 2403472807987180236, guid: 6d5e99f1212cda44f96e7244171aa5f9, type: 3}
      propertyPath: m_Center.y
      value: -0.5
      objectReference: {fileID: 0}
    - target: {fileID: 9031208762655722718, guid: 6d5e99f1212cda44f96e7244171aa5f9, type: 3}
      propertyPath: dialogueSequence.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 9031208762655722718, guid: 6d5e99f1212cda44f96e7244171aa5f9, type: 3}
      propertyPath: dialogueSequence.Array.data[0].text
      value: We made it... Wait, come on. Do we really have to climb even more?
      objectReference: {fileID: 0}
    - target: {fileID: 9031208762655722718, guid: 6d5e99f1212cda44f96e7244171aa5f9, type: 3}
      propertyPath: dialogueSequence.Array.data[1].text
      value: A true knight never complains about the path to glory, Sancho!
      objectReference: {fileID: 0}
    - target: {fileID: 9031208762655722718, guid: 6d5e99f1212cda44f96e7244171aa5f9, type: 3}
      propertyPath: dialogueSequence.Array.data[2].text
      value: Easy for you to say... Lok, see that tree next to the shack on the right?
      objectReference: {fileID: 0}
    - target: {fileID: 9031208762655722718, guid: 6d5e99f1212cda44f96e7244171aa5f9, type: 3}
      propertyPath: dialogueSequence.Array.data[3].text
      value: Let's try climbing up through there instead!
      objectReference: {fileID: 0}
    - target: {fileID: 9031208762655722718, guid: 6d5e99f1212cda44f96e7244171aa5f9, type: 3}
      propertyPath: dialogueSequence.Array.data[4].text
      value: A clever strategy, my squire!
      objectReference: {fileID: 0}
    - target: {fileID: 9031208762655722718, guid: 6d5e99f1212cda44f96e7244171aa5f9, type: 3}
      propertyPath: dialogueSequence.Array.data[5].text
      value: But honestly... how are we supposed to get up onto it?
      objectReference: {fileID: 0}
    - target: {fileID: 9031208762655722718, guid: 6d5e99f1212cda44f96e7244171aa5f9, type: 3}
      propertyPath: dialogueSequence.Array.data[0].speaker
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 9031208762655722718, guid: 6d5e99f1212cda44f96e7244171aa5f9, type: 3}
      propertyPath: dialogueSequence.Array.data[2].speaker
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 9031208762655722718, guid: 6d5e99f1212cda44f96e7244171aa5f9, type: 3}
      propertyPath: dialogueSequence.Array.data[3].speaker
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 9031208762655722718, guid: 6d5e99f1212cda44f96e7244171aa5f9, type: 3}
      propertyPath: dialogueSequence.Array.data[4].speaker
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 9031208762655722718, guid: 6d5e99f1212cda44f96e7244171aa5f9, type: 3}
      propertyPath: dialogueSequence.Array.data[5].speaker
      value: 1
