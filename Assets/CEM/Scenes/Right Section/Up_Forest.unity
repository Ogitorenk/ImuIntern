    - target: {fileID: 9031208762655722718, guid: 6d5e99f1212cda44f96e7244171aa5f9, type: 3}
      propertyPath: dialogueSequence.Array.data[0].text
      value: Woah, hold on! Watch your step!
      objectReference: {fileID: 0}
    - target: {fileID: 9031208762655722718, guid: 6d5e99f1212cda44f96e7244171aa5f9, type: 3}
      propertyPath: dialogueSequence.Array.data[1].text
      value: These old branches look paper-thin. The moment we jump on them, they're
