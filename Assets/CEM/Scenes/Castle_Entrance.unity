--- !u!1001 &3157479508746962734
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 2902947233031057038, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: m_Name
      value: NPCDialogueTrigger_Zone
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: interactionHintUI
      value: 
      objectReference: {fileID: 55447805}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.size
      value: 9
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[0].text
      value: Hello, travelers. My name is Daisy. How can I help you.
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[1].text
      value: Greetings, fair Lady Daisy! We seek passage to the throne room.
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[2].text
      value: Lady? Master, what are you doing? That is just a wooden training dummy...
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[3].text
      value: Welcome, brave knight. I am afraid the path to the throne is sealed.
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[4].text
      value: You must open the grand portcullises ahead to enter.
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[5].text
      value: Seek out the two levers hidden in the Left and Right wings of the castle.
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[6].text
      value: Fear not, my delicate flower! We shall activate these levers and clear
        the way!
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[7].text
      value: Delicate flower?! Master, you are talking to a log with a painted smile!
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[8].text
      value: Silence, Sancho! Do not interrupt the lady. To the castle wings!
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[2].speaker
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[3].speaker
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
