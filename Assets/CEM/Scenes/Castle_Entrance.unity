      propertyPath: dialogueSequence.Array.data[0].text
      value: Do you see this majestic view, Sancho?
      objectReference: {fileID: 0}
    - target: {fileID: 9031208762655722718, guid: 6d5e99f1212cda44f96e7244171aa5f9, type: 3}
      propertyPath: dialogueSequence.Array.data[1].text
      value: It is truly breathtaking!
      objectReference: {fileID: 0}
    - target: {fileID: 9031208762655722718, guid: 6d5e99f1212cda44f96e7244171aa5f9, type: 3}
      propertyPath: dialogueSequence.Array.data[2].text
      value: Forgive me, master... But all I see is rubble and broken stones.
