    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: interactionHintUI
      value: 
      objectReference: {fileID: 55447805}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[0].text
      value: Ah, Lady Daisy! We have conquered the first gate!
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[1].text
      value: Why does this wooden dummy keep appearing everywhere?
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[2].text
      value: Well done, sir knight. But the throne room is still sealed.
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[3].text
      value: You must go through the door straight ahead. It will lead you into the
        Right Wing of the castle.
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[4].text
      value: The Right Wing it is! Let us march forward, Sancho!
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[5].text
      value: Are we really taking directions from a log now? Fine...
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[6].text
      value: Silence, Sancho! Do not interrupt the lady. To the castle wings!
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[7].text
      value: Silence, Sancho! Do not interrupt the lady. To the castle wings!
      objectReference: {fileID: 0}
    - target: {fileID: 6847402786881251710, guid: 03a382364099f7c4d87283509b6b8805, type: 3}
      propertyPath: dialogueSequence.Array.data[8].text
      value: Silence, Sancho! Do not interrupt the lady. To the castle wings!
      objectReference: {fileID: 0}
